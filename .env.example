# Salin ke `.env` (sudah di-gitignore) lalu isi. JANGAN commit `.env`.

# CARA PALING MUDAH:
# Dashboard → Project Settings → Database → Connection string → tab "Session" (port 5432).
# Salin URI-nya apa adanya, ganti bagian [YOUR-PASSWORD] dengan password asli,
# lalu tempel di bawah ini sebagai satu baris.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Dipakai sisi Flutter nanti. anon key aman dipublikasikan; service_role TIDAK,
# dan tidak dibutuhkan untuk pekerjaan ini.
SUPABASE_URL=
SUPABASE_ANON_KEY=

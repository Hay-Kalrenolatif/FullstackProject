        </mxCell>
        <mxCell id="BJWxaX-mFTfvrpEd92f0-22" parent="1" style="ellipse;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" value="Lihat Ringkasan Lab" vertex="1">
          <mxGeometry height="60" width="130" x="439" y="743" as="geometry" />
        </mxCell>
        <mxCell id="BJWxaX-mFTfvrpEd92f0-23" parent="1" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;spacing=8;" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• &lt;font color=&quot;#d79b00&quot;&gt;&lt;b&gt;panah tebal&lt;/b&gt;&lt;/font&gt; = jalur utama 1 → 9, hafalkan sampai di sini saja&lt;br&gt;• nomor = urutan pemakaian; huruf (4a, 6b, 7b) = cabang dari langkah itu&lt;br&gt;• use case tanpa angka = jalur mandiri, di luar satu putaran&lt;br&gt;• elips hijau = terjadi di HP, elips biru = terjadi di panel web&lt;br&gt;• &lt;font color=&quot;#2f6f2f&quot;&gt;putus hijau&lt;/font&gt; = «include», &lt;font color=&quot;#9673a6&quot;&gt;putus ungu&lt;/font&gt; = «extend»&lt;br&gt;• segitiga terbuka = Admin &lt;i&gt;is-a&lt;/i&gt; Pengguna (login-nya sama)" vertex="1">
          <mxGeometry height="240" width="300" x="-10" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="BJWxaX-mFTfvrpEd92f0-24" parent="1" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;spacing=8;" value="&lt;b&gt;Satu putaran, satu kalimat&lt;/b&gt;&lt;br&gt;Pengguna masuk, melihat lab, menemukan unit rusak, mengajukan laporan — laporan itu muncul di antrean admin, diperiksa, disetujui, dicatat perbaikannya, lalu kembali terlihat di HP pengguna sebagai selesai. Pengguna keluar.&lt;br&gt;&lt;br&gt;&quot;Buat / Reset / Hapus Akun&quot; di luar kotak karena menuntut service_role, yang tidak boleh ikut dibundel ke web build." vertex="1">
          <mxGeometry height="210" width="420" x="400" y="1220" as="geometry" />
        </mxCell>

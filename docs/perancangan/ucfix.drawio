        <mxCell id="BJWxaX-mFTfvrpEd92f0-21" parent="1" style="ellipse;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" value="Kelola Akun &amp; Peran" vertex="1">

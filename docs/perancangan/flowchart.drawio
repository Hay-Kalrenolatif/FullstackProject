  <diagram id="p2" name="Cabang dan Aturan">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2n1" value="&lt;b&gt;A. Aset sudah punya tiket terbuka?&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="75" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2n2" value="ada tiket belum selesai untuk aset yang sama?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="150" y="185" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2n3" value="pelapor dicatat sebagai &lt;b&gt;saksi&lt;/b&gt; (report_witness) pada tiket yang ada — tiket kedua tidak dibuat" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="342" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2n4" value="tiket baru dibuat, &lt;i&gt;prev_asset_status&lt;/i&gt; direkam untuk pemulihan saat ditolak / dibatalkan" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="130" y="462" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2n5" value="Ditegakkan oleh partial unique index reports_open_pc / reports_open_support: satu tiket terbuka per aset." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2n6" value="&lt;b&gt;B. Akun bukan admin&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="605" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2n7" value="profiles.role = admin dan is_active?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="150" y="715" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2n8" value="setiap RPC admin memanggil app.resolve_admin() dan gagal · RLS + privilege tetap menolak" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="130" y="872" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2n9" value="UI hanya menampilkan layar &quot;Anda bukan admin&quot; — kosmetik, penegaknya ada di server" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="992" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2n10" value="panel terbuka penuh" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="732" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2n11" value="&lt;b&gt;C. Aturan p_asset_status saat Approve&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="75" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2n12" value="p_asset_status yang  dipilih?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="925" y="185" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2n13" value="tiket &quot;diproses&quot; · aset tetap &lt;b&gt;rusak&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="740" y="362" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2n14" value="tiket &quot;diproses&quot; · aset &lt;b&gt;diperiksa&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1090" y="362" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2n15" value="ditolak server — &quot;baik&quot;, &quot;habis&quot;, &quot;purnatugas&quot; bukan hasil approve; mengembalikan aset ke &quot;baik&quot; adalah pekerjaan Selesaikan" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="885" y="482" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2n16" value="&lt;b&gt;D. Stok hanya bergerak beralasan&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="625" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2n17" value="ada barang masuk / keluar?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="925" y="735" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2n18" value="p_qty_delta + alasan (≥3 karakter) → dibukukan sebagai baris riwayat &lt;i&gt;pelengkapan&lt;/i&gt; atau &lt;i&gt;purnatugas&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="730" y="897" width="300" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2n19" value="delta 0 — dan &lt;b&gt;jangan diisi lagi&lt;/b&gt; saat Complete, kalau diisi di keduanya stok bergerak dua kali" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1090" y="897" width="300" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2n20" value="&lt;b&gt;E. Setelah tiket selesai&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="1075" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2n21" value="perlu dibuka lagi?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="840" y="1170" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2n22" value="sibal_reopen_report → tiket kembali ke antrean, aset masuk &quot;dalam_pengajuan&quot; lagi" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1142" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2n23" value="pelapor membatalkan sebelum selesai?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="830" y="1288" width="240" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p2n24" value="sibal_cancel_report — hanya pemilik, hanya tiket masih terbuka → tiket &quot;batal&quot;, aset dipulihkan" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1272" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2n25" value="&lt;b&gt;Kenapa cabang ini dipisah&lt;/b&gt;&lt;br&gt;Halaman 1 hanya jalur utama supaya bisa diceritakan sekali tarik. Aturan yang membuat sistemnya aman (satu tiket per aset, approve tidak boleh menghasilkan &quot;baik&quot;, stok wajib alasan, pembatalan hanya oleh pemilik) justru hidup di halaman ini." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="-50" y="1080" width="300" height="200" as="geometry" />
        </mxCell>
